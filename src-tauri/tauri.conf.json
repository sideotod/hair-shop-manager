{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Hairhaeyo",
  "version": "0.1.0",
  "identifier": "com.hairhaeyo.salon",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build && node scripts/prepare-tauri-sidecar.mjs",
    "devUrl": "http://localhost:3000"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Hairhaeyo",
        "width": 1440,
        "height": 1000,
        "minWidth": 1280,
        "minHeight": 720,
        "visible": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "externalBin": ["binaries/node"],
    "resources": {
      "../.next/standalone/": "server/"
    },
    "icon": ["icons/icon.ico"]
  }
}
